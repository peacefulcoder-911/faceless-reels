# ==============================================================================
# FacelessReels Configuration Template
# Copy this file to .env and populate the required API keys and credentials.
# NEVER commit your actual .env file or credentials to version control.
# ==============================================================================

# --- AI Script & Text-to-Speech Generation (Google Gemini) ---
# Required for autonomous scripting, topic selection, and Gemini TTS ("Achird" voice).
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Studio Narration (ElevenLabs - Optional) ---
# Optional: Used for high-fidelity multi-voice narration (e.g. Brian, Adam, Elena).
# If omitted or not configured, the pipeline gracefully falls back to Gemini TTS or system TTS.
# Obtain an API key from ElevenLabs: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# --- YouTube Data API v3 & Publishing (Optional) ---
# Used for autonomous video upload, playlist organization, and pinned comments.
# Download your OAuth 2.0 Desktop Client secret from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Save the JSON file to config/client_secrets.json (referenced below).
YOUTUBE_CLIENT_SECRETS_FILE=config/client_secrets.json
YOUTUBE_TOKEN_FILE=config/youtube_token.json

# --- Server & Runtime Environment ---
PORT=8000
HOST=127.0.0.1
LOG_LEVEL=INFO
DEBUG=false

